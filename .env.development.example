# Copy to .env.development for local overrides. Never commit the real file.
POSTGRES_DB=farmspot_development
POSTGRES_USER=farmspot
POSTGRES_PASSWORD=farmspot
JWT_SIGNING_KEY=replace-with-a-local-random-value

# Optional services running on the host machine.
NEWS_TRANSLATOR_BASE_URL=http://host.docker.internal:19191
NEWS_GAME_ID_BASE_URL=http://host.docker.internal:19192

# Optional host port overrides.
WEB_PORT=3002
FRONTEND_PORT=8082
